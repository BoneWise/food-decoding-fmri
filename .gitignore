# Allowlist: only the minimal set needed to reproduce the manuscript is versioned.
# Everything else in this working directory (raw data links, run outputs, drafts,
# notes, local tools) stays local. Add a path below only if reproduction needs it.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/CITATION.cff
!/Makefile
!/pyproject.toml
!/paper/
!/src/
!/analyses/
!/preprocessing/
!/configs/
!/environments/
!/results/
!/scripts/
!/tests/
!/docs/
!/data/

/paper/*
!/paper/main.pdf
/preprocessing/*
!/preprocessing/run_minimal_lsa.m
!/preprocessing/run_rating14_sessionwise_glm.m
/scripts/*
!/scripts/reproduce_results.py
!/scripts/validate_reference.py
/docs/*
!/docs/data.md
!/docs/analysis-entrypoints.md
!/docs/results.md
/data/*
!/data/README.md
/results/*
!/results/reference/
/results/reference/background/
/results/reference/*/archived/

# Generated files anywhere
.DS_Store
._*
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.env
.env.*
*.pt
*.pth
*.ckpt
*.npy
*.npz
*.log
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.run.xml
*.out
*.synctex.gz
